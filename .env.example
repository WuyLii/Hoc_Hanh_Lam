# GEMINI_API_KEY: Required for Gemini AI API calls (Mã nguồn chính).
# AI Studio / Vercel injects this at runtime from secrets / environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_2: Optional second Gemini API key for load-balancing and auto-failover on Vercel / server.
# Cung cấp mã nguồn số 2 để nhân đôi hạn mức quota và tự động dự phòng 429 khi deploy trên Vercel.
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Database Configuration
VITE_SUPABASE_URL="https://fzdxabrvddjtpnbjvcii.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
